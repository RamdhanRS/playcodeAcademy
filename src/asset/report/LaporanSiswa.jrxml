	<queryString language="SQL">
		<![CDATA[SELECT nama,
	no_hp,
	email,
	alamat,
	tgl_lahir,
	jenis_kelamin,
	status
FROM playcode_academy.users
WHERE 
	 playcode_academy.users.level = $P{LEVEL}]]>
	</queryString>
