	<queryString language="SQL">
		<![CDATA[SELECT playcode_academy.classes.class_name,
	playcode_academy.classes.start_date,
	playcode_academy.classes.end_date,
	playcode_academy.classes.capacity,
	playcode_academy.users.nama AS coach_name
FROM playcode_academy.classes
	INNER JOIN playcode_academy.users ON 
	 playcode_academy.classes.coach_id = playcode_academy.users.id]]>
	</queryString>
